# ---- Database (Neon) ----
# Pooled connection string — used by the running app at runtime, via the
# Neon driver adapter in src/lib/prisma.ts. Neon calls this the "Pooled
# connection" string (hostname contains "-pooler").
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# Direct (unpooled) connection string — used by prisma.config.ts, which is
# what the Prisma CLI (migrate, studio, db push) reads. Migrations need a
# direct connection to run DDL; the app itself never reads this value.
DIRECT_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"

# ---- Better Auth ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-32+-character-secret"
# The public URL this API is served from (better-auth uses this to build
# callback/cookie URLs). Use your deployed URL in production.
BETTER_AUTH_URL="http://localhost:4000"

# ---- CORS ----
# Comma-separated list of origins allowed to call this API with credentials
# (your frontend's URL(s)).
CLIENT_ORIGIN="http://localhost:3000"

# ---- Server ----
NODE_ENV="development"
PORT=4000

# ---- Onboarding tokens (optional) ----
# Salt used to hash onboarding/invite tokens before storing them.
ONBOARDING_TOKEN_SALT="change-me-too"
# Set to "true" to require a valid OnboardingToken before a new company can
# be created (invite-only rollout). Defaults to false.
REQUIRE_ONBOARDING_TOKEN="false"
